# ShikshaSync Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit .env — it's in .gitignore

# ElevenLabs API Key (for TTS audio generation)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# DynamoDB Table Names
DYNAMODB_EVENTS_TABLE=shikshasync-events
DYNAMODB_LESSONS_TABLE=shikshasync-lessons
DYNAMODB_STUDENTS_TABLE=shikshasync-students

# S3 Bucket for Lesson Packs
S3_LESSON_PACKS_BUCKET=shikshasync-lesson-packs
S3_AUDIO_BUCKET=shikshasync-audio

# CloudFront Distribution
CLOUDFRONT_DISTRIBUTION_ID=your_distribution_id
CLOUDFRONT_DOMAIN=your_domain.cloudfront.net

# Cognito (Teacher Dashboard Auth)
COGNITO_USER_POOL_ID=your_user_pool_id
COGNITO_CLIENT_ID=your_client_id
COGNITO_REGION=us-east-1

# API Gateway
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# Flutter App Config
FLUTTER_APP_NAME=ShikshaSync
FLUTTER_BUNDLE_ID=com.coderangers.shikshasync